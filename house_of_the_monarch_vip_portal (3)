<!DOCTYPE html>
<html lang="en" class="dark h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>House of the Monarch | VIP Sovereign Portal</title>
  
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            royal: {
              950: '#090314',
              900: '#140828',
              800: '#260e48',
              700: '#3d166e',
              500: '#7c2d12',
            },
            gold: {
              100: '#fef3c7',
              200: '#fde68a',
              300: '#fcd34d',
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
              700: '#b45309',
            }
          },
          fontFamily: {
            cinzel: ['Cinzel', 'serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          }
        }
      }
    }
    // Global Error Handler for Primary Banner Fallback Chain
    function handlePrimaryBannerError(img) {
      console.warn("Primary banner file not found. Executing secondary fallback chain...");
      const fallbacks = [
        'image_c41ebe.jpg',
        'house of the monarch banner 1 of 3_2.jpeg',
        'house of the monarch banner 1 of 3.jpeg',
        'PSX_20261012_155202.jpg',
        'PSX_20261012_154620.jpg'
      ];
      
      let attemptIndex = parseInt(img.dataset.attempt || "0");
      attemptIndex++;
      img.dataset.attempt = attemptIndex;

      if (attemptIndex < fallbacks.length) {
        img.src = fallbacks[attemptIndex];
      } else {
        console.warn("All image files unreadable in current environment. Revealing 3-panel vector banner.");
        img.style.display = 'none';
        const vectorFallback = document.getElementById('vector-banner-fallback');
        if (vectorFallback) vectorFallback.classList.remove('hidden');
      }
    }

    function handleQuoteBannerError(img) {
      img.onerror = function() {
        img.style.display = 'none';
        const fallback = document.getElementById('quote-banner-fallback');
        if (fallback) fallback.classList.remove('hidden');
      };
      img.src = '1776894008682.png';
    }

    function handleShopBannerError(img) {
      img.onerror = function() {
        img.style.display = 'none';
        const fallback = document.getElementById('shop-banner-fallback');
        if (fallback) fallback.classList.remove('hidden');
      };
      img.src = '1777105275250.png';
    }

    function handleOFBannerError(img) {
      img.onerror = function() {
        img.style.display = 'none';
        const fallback = document.getElementById('of-banner-fallback');
        if (fallback) fallback.classList.remove('hidden');
      };
      img.src = 'Picsart_26-04-22_18-53-51-430.jpg';
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 50% 0%, #20083b 0%, #090314 65%, #030108 100%);
