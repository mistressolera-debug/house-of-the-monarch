    .purple-glow { box-shadow: 0 0 35px -5px rgba(124, 45, 18, 0.45); }
    
    .blur-inspection {
      filter: blur(14px);
      transition: filter 0.3s ease-in-out;
    }
    .blur-inspection.unblurred {
      filter: blur(0px);
    }
  </style>
</head>
<body class="min-h-screen text-slate-200 flex flex-col antialiased selection:bg-gold-500 selection:text-slate-950">

