  <!-- JAVASCRIPT ENGINE -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Tab Switcher Function
    function switchMainTab(tabId) {
      document.querySelectorAll('.tab-section').forEach(el => el.classList.add('hidden'));
      const activeSection = document.getElementById(`section-${tabId}`);
      if (activeSection) activeSection.classList.remove('hidden');

      document.querySelectorAll('.nav-tab-btn').forEach(btn => {
        btn.classList.remove('bg-gold-500', 'text-slate-950');
        btn.classList.add('text-slate-400');
      });

      const activeBtn = document.getElementById(`nav-${tabId}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-gold-500', 'text-slate-950');
        activeBtn.classList.remove('text-slate-400');
      }
    }

    // Direct File Upload Handler for Custom Banner
    function handleDirectBannerUpload(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const bannerImg = document.getElementById('primary-royal-banner');
          const vectorFallback = document.getElementById('vector-banner-fallback');
          
          bannerImg.src = e.target.result;
          bannerImg.style.display = 'block';
          if (vectorFallback) vectorFallback.classList.add('hidden');
          
          localStorage.setItem('monarch_custom_banner_data', e.target.result);
        };
        reader.readAsDataURL(file);
      }
    }

    // Restore Saved Banner File
    window.addEventListener('DOMContentLoaded', () => {
      const savedData = localStorage.getItem('monarch_custom_banner_data');
      if (savedData) {
        const bannerImg = document.getElementById('primary-royal-banner');
        if (bannerImg) bannerImg.src = savedData;
      }
    });

    // ID Unblur Modal Logic
    function openIDInspector(imgUrl) {
      const modal = document.getElementById('id-inspector-modal');
      const img = document.getElementById('inspector-id-img');
      img.src = imgUrl;
      img.classList.remove('unblurred'); // Always start blurred
      modal.classList.remove('hidden');
    }

    function closeIDInspector() {
      document.getElementById('id-inspector-modal').classList.add('hidden');
    }

    function toggleIDUnblur() {
      const img = document.getElementById('inspector-id-img');
      img.classList.toggle('unblurred');
    }

    // VIP Gate Modal Logic
    function openVIPModal() {
      document.getElementById('vip-gate-modal').classList.remove('hidden');
    }

    function closeVIPModal() {
      document.getElementById('vip-gate-modal').classList.add('hidden');
    }

    function switchVIPTab(tabName) {
      document.getElementById('vip-form-login').classList.add('hidden');
      document.getElementById('vip-form-apply').classList.add('hidden');
      document.getElementById('vip-form-recover').classList.add('hidden');

      document.getElementById(`vip-form-${tabName}`).classList.remove('hidden');

      ['login', 'apply', 'recover'].forEach(t => {
        const btn = document.getElementById(`vip-tab-${t}`);
        if (t === tabName) {
          btn.classList.add('bg-gold-500', 'text-slate-950');
          btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('bg-gold-500', 'text-slate-950');
          btn.classList.add('text-slate-400');
        }
      });
    }

    function handleVIPLogin() {
      closeVIPModal();
      switchMainTab('vault');
    }

    function handleVIPApply() {
      closeVIPModal();
      switchMainTab('audience');
    }

    function handleVIPRecover() {
      closeVIPModal();
    }
  </script>

